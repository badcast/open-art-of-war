# Script mode (cmake -P): the fingerprint of the simulation code, so two builds with any difference in it
# (AI, units, pathfinding, economy, ...) never play one network match or one replay as if they were the same.
#   -DOUT=<header>  -DROOT=<source dir>  -DLIST=<text file: one path per line, relative to ROOT, any order>
# Writes `kSimSourceHash` (64 bits of the SHA-256 over the sorted paths and their contents).
cmake_minimum_required(VERSION 3.16)
file(STRINGS "${LIST}" files)
list(SORT files)
set(all "")
foreach(rel IN LISTS files)
    # Line ends do not count: a Windows checkout (CRLF) must match a Linux one
    file(READ "${ROOT}/${rel}" content)
    string(REPLACE "\r" "" content "${content}")
    string(SHA256 h "${content}")
    string(APPEND all "${rel}=${h}\n")
endforeach()
string(SHA256 digest "${all}")
string(SUBSTRING "${digest}" 0 16 short)
list(LENGTH files count)
set(text "// Generated by cmake/SimBuildId.cmake from the simulation sources (${count} files) - do not edit\n")
string(APPEND text "#pragma once\n#include <cstdint>\n\n")
string(APPEND text "namespace OpenArtOfWar\n{\ninline constexpr std::uint64_t kSimSourceHash = 0x${short}ull;\n}\n")
# Rewrite only on change: the engine is not recompiled for nothing
if(EXISTS "${OUT}")
    file(READ "${OUT}" old)
    if(old STREQUAL text)
        return()
    endif()
endif()
file(WRITE "${OUT}" "${text}")
