# Script mode (cmake -P): turns compiled shaders into C++ byte arrays.
#   -DOUT=<header>  -DDIR=<directory with <name>.frag.spv / <name>.frag.msl>  -DNAMES=<name;name;...>
# A missing format becomes an empty array, so the game finds out at run time what it can use.
cmake_minimum_required(VERSION 3.16)
set(text "// Generated by cmake/EmbedShaders.cmake from shaders/*.frag - do not edit\n#pragma once\n#include <cstddef>\n\n")
foreach(name IN LISTS NAMES)
    foreach(fmt spv msl)
        set(file "${DIR}/${name}.frag.${fmt}")
        set(var "kShader_${name}_${fmt}")
        if(EXISTS "${file}")
            file(READ "${file}" hex HEX)
            file(SIZE "${file}" size)
            string(REGEX REPLACE "([0-9a-f][0-9a-f])" "0x\\1," bytes "${hex}")
            string(APPEND text "static const unsigned char ${var}[] = {${bytes}0x00};\n")
            string(APPEND text "static const std::size_t ${var}_size = ${size};\n")
        else()
            string(APPEND text "static const unsigned char* const ${var} = nullptr;\n")
            string(APPEND text "static const std::size_t ${var}_size = 0;\n")
        endif()
    endforeach()
endforeach()
# Rewrite only on change: the engine is not recompiled for nothing
if(EXISTS "${OUT}")
    file(READ "${OUT}" old)
    if(old STREQUAL text)
        return()
    endif()
endif()
file(WRITE "${OUT}" "${text}")
