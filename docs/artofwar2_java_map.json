  "class_descriptions": {
    "aow22": "MIDlet entry point, application lifecycle (startApp, pauseApp, destroyApp)",
    "a": "Core engine canvas and main game loop (fixed timestep, double buffer, rendering, input handling, asset streaming)",
    "b": "Bluetooth multiplayer networking (discovery, connection, RFCOMM/L2CAP transport)",
    "c": "Game balance constants, unit definition IDs, weapon stats, building types, and faction color palette LUT",
    "d": "Audio manager for MIDI background music (/s0) and sound effects (/d0) with volume control",
    "e": "Bitmap font renderer supporting multiple font textures (/s, /t, /d), metrics and string formatting",
    "f": "High-level game world, campaign progression, UI menus, in-game HUD, minimap, orders dispatch, RMS save/load",
    "g": "Device profile and platform configuration, carrier/vendor metadata, string table helper",
    "h": "Asset offsets, binary resource sizes, font glyph index constants",
    "i": "RTS simulation core, entity management (SoA unit table), combat resolution, ballistics, line-of-sight fog-of-war, A* pathfinding",
    "j": "HTTP error/telemetry reporter for remote crash diagnostics",
    "k": "Legacy SMS monetization and carrier billing handler"
  },
