msgstr "[НУЖНА ЛАБОРАТОРИЯ] Исследования стоят, пока не построена лаборатория"

msgid "[TECH CENTER REQUIRED] Research is paused until a Tech Center is built"
msgstr "[НУЖЕН ТЕХ-ЦЕНТР] Исследования стоят, пока не построен тех-центр"

msgid "Building"
msgstr "Здание"

