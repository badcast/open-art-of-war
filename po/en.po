#. Character description (assets/characters, by id)
msgid "bunker_conf.description"
msgstr "Heavy reinforced concrete pillbox of the Confederation with an automated machine gun port."

#. Character description (assets/characters, by id)
msgid "command_center_conf.description"
msgstr "Main headquarters of the Confederation forces. Coordinates operations, provides base credit supplies, and baseline power (+50 kW)."

#. Character description (assets/characters, by id)
msgid "infantry_center_conf.description"
msgstr "Confederation regular infantry barracks: trains riflemen, heavy rocket assault troops, and flamethrowers."

#. Character description (assets/characters, by id)
msgid "missile_turret_conf.description"
msgstr "Long-range automated missile defense turret of the Confederation with an independent rotating launcher."

#. Character description (assets/characters, by id)
msgid "power_generator_conf.description"
msgstr "Heavy power plant (+100 kW). Supplies electricity to tank factories, tech centers, and missile turrets."

#. Character description (assets/characters, by id)
msgid "radar_locator_conf.description"
msgstr "Confederation radar surveillance tower equipped with a rotating antenna for long-range area scanning."

#. Character description (assets/characters, by id)
msgid "tech_center_conf.description"
msgstr "Advanced military research and technology complex: unlocks upgrades for Zeus tanks and Grad MLRS siege systems."

#. Character description (assets/characters, by id)
msgid "vehicle_factory_conf.description"
msgstr "Heavy armor production facility: manufactures TM-40 Fortress vehicles, T-21 Hammer tanks, T-22 Zeus tanks, and Grad MLRS."

#. Character description (assets/characters, by id)
msgid "wall_conf.description"
msgstr "Solid reinforced concrete wall of the Confederation military, designed to seal chokepoints and block invaders."

#. Character description (assets/characters, by id)
msgid "flamethrower_conf.description"
msgstr "Specialist in clearing cover, bunkers, and foliage. Unleashes devastating damage with high-temperature flame streams."

#. Character description (assets/characters, by id)
msgid "fortress_conf.description"
msgstr "Super-heavy assault vehicle of the Confederation with enhanced armor plating and flamethrower weaponry."

#. Character description (assets/characters, by id)
msgid "grad_conf.description"
msgstr "Long-range multiple rocket launcher system. Capable of deploying stabilizing artillery outriggers in siege mode."

#. Character description (assets/characters, by id)
msgid "grad_conf_siege.description"
msgstr "Deployed artillery battery of the Grad MLRS: maximum destruction range against enemy fortifications."

#. Character description (assets/characters, by id)
msgid "hammer_conf.description"
msgstr "Main battle tank of the Confederation featuring a rapid-fire cannon and a 360-degree rotating turret."

#. Character description (assets/characters, by id)
msgid "heavy_assault_conf.description"
msgstr "Confederation exo-suit trooper armed with an RPG launcher, specialized in breaching armored vehicles and bases."

#. Character description (assets/characters, by id)
msgid "rifleman_conf.description"
msgstr "Regular infantry trooper of the Confederation wearing tactical body armor and armed with an automatic rifle."

#. Character description (assets/characters, by id)
msgid "zeus_conf.description"
msgstr "Elite heavy tank of the Confederation featuring dual cannons and an overhead missile launcher turret."

#. Character description (assets/characters, by id)
msgid "barracks_res.description"
msgstr "Field training encampment for recruiting guerrilla forces: Rifleman, Grenadier, Sniper. Fitted with a defensive machine gun."

#. Character description (assets/characters, by id)
msgid "bunker_res.description"
msgstr "Resistance concrete machine gun bunker for base perimeter protection against enemy infantry and light scouts."

#. Character description (assets/characters, by id)
msgid "factory_res.description"
msgstr "Military manufacturing facility: produces Coyote buggies, Armadillo tanks, Rhino heavy tanks, and Porcupine MLRS."

#. Character description (assets/characters, by id)
msgid "guard_tower_res.description"
msgstr "Resistance watchtower armed with a heavy machine gun and granting an extended reconnaissance radius."

#. Character description (assets/characters, by id)
msgid "headquarters_res.description"
msgstr "Main command center of the Resistance partisans. Provides supply lines, power generation (+50 kW), and tactical radar."

#. Character description (assets/characters, by id)
msgid "powerplant_res.description"
msgstr "Electricity generator (+100 kW). Supplies essential power for factories, barracks, and defense towers."

#. Character description (assets/characters, by id)
msgid "research_lab_res.description"
msgstr "Underground research and engineering laboratory to unlock heavy armor (Rhino, Porcupine) and specialized siege modes."

#. Character description (assets/characters, by id)
msgid "wall_res.description"
msgstr "Destructible defensive barricade constructed from sandbags and barbed wire to delay hostile vehicles."

#. Character description (assets/characters, by id)
msgid "assault_tank_res.description"
msgstr "Medium assault tank of the Resistance with balanced armor, a rapid-fire cannon, and a rotating turret."

#. Character description (assets/characters, by id)
msgid "coyote_res.description"
msgstr "Fast reconnaissance buggy equipped with a 360-degree machine gun turret. Optimal for scouting and infantry clearing."

#. Character description (assets/characters, by id)
msgid "grenadier_res.description"
msgstr "Heavy assault partisan launching explosive grenades against defense fortifications and infantry clusters."

#. Character description (assets/characters, by id)
msgid "heavy_tank_res.description"
msgstr "Heavy breakthrough tank boasting reinforced frontal armor. Transforms into a long-range siege cannon once researched."

#. Character description (assets/characters, by id)
msgid "heavy_tank_res_siege.description"
msgstr "Rhino siege position: anchors stabilizing outriggers and bombards enemy positions with heavy high-explosive shells."

#. Character description (assets/characters, by id)
msgid "mlrs_res.description"
msgstr "Mobile multiple rocket launcher system. Unleashes catastrophic rocket salvos against enemy bases and wall zones."

#. Character description (assets/characters, by id)
msgid "rifleman_res.description"
msgstr "Light infantry recruit of the Resistance, equipped with an assault rifle."

#. Character description (assets/characters, by id)
msgid "sniper_res.description"
msgstr "Marksman with high effective firing range. Can deploy into a concealed prone position (siege mode [G])."

#. Character description (assets/characters, by id)
msgid "sniper_res_siege.description"
msgstr "Prone sniper siege position: maximizes firing range and damage potential while stationary."

