# Research (original technology names and descriptions)
msgid "POWER SUIT"
msgstr "Энергетический костюм"

msgid "+2 armor for all infantry."
msgstr "Увеличивает броню всей пехоты на 2."

msgid "BIO SUIT"
msgstr "Био-костюм"

msgid ""
"Health regeneration of all infantry is 3 times faster.\n"
"Requires: Power Suit."
msgstr ""
"Для всей пехоты скорость регенерации здоровья увеличивается в 3 раза.\n"
"Требует: Энергетический костюм."

msgid "RAPID FIRE"
msgstr "Повыш. скорострельность"

msgid "Rate of fire of Assault infantry +50%."
msgstr "Скорострельность штурмовиков увеличивается на 50%."

msgid "ARMOR-PIERCING ROUNDS"
msgstr "Бронебойные пули"

msgid "Damage of Assault infantry +40%."
msgstr "Поражающая способность штурмовиков увеличивается на 40%."

msgid "IMPROVED SMALL ROCKETS"
msgstr "Усил. малые ракеты"

msgid "Damage of Heavy Assault infantry +40%."
msgstr "Поражающая способность тяжелых штурмовиков увеличивается на 40%."

msgid "LAVA FUEL MIX"
msgstr "Горючая смесь 'Лава'"

msgid "Unlocks Flamethrower infantry. Their fire does not hurt Confederation infantry and vehicles thanks to fireproof armor."
msgstr "Позволяет создавать огнеметчиков. Огнемет не причиняет вреда пехоте и технике Конфедерации, благодаря огнеупорной броне."

msgid "VULCAN HEAVY FLAMETHROWER"
msgstr "Тяж. огнемет 'Вулкан'"

msgid ""
"A heavy flamethrower is mounted on the TM-40 Fortress.\n"
"Requires: Lava Fuel Mix."
msgstr ""
"Тяжелый огнемет устанавливается на ТМ-40 'Крепость'.\n"
"Требует: Горючая смесь 'Лава'."

msgid "Damage of Zeus and Hammer tanks +25%."
msgstr "Увеличивает поражающую способность танков 'Зевс' и 'Молот' на 25%."

msgid "REINFORCED ENGINE"
msgstr "Усиленный двигатель"

msgid "Speed of all vehicles +1."
msgstr "Увеличивает скорость всей техники на 1."

msgid "POWER ARMOR"
msgstr "Энергетическая броня"

msgid ""
"+2 armor for all vehicles.\n"
"Requires: Reinforced Engine."
msgstr ""
"Увеличивает броню всей техники на 2.\n"
"Требует: Усиленный двигатель."

msgid "DAMAGE DIAGNOSTICS"
msgstr "Диагностика повреждений"

msgid ""
"Vehicle repair is 3 times faster.\n"
"Requires: Reinforced Engine."
msgstr ""
"Увеличивает скорость ремонта техники в 3 раза.\n"
"Требует: Усиленный двигатель."

msgid "FAST RELOAD"
msgstr "Быстрая перезарядка"

msgid ""
"Reload time of Zeus and Hammer tanks is shorter.\n"
"Requires: Reinforced Engine."
msgstr ""
"Снижает время перезарядки танков 'Зевс' и 'Молот'.\n"
"Требует: Усиленный двигатель."

msgid "ROCKET LAUNCHER MOUNT"
msgstr "Маш. ракетная установка"

msgid ""
"A turret with heavy rockets is mounted on the Zeus tank.\n"
"Requires: Reinforced Engine."
msgstr ""
"Поворотная ракетная установка с тяжелыми ракетами. Устанавливается на танк 'Зевс'.\n"
"Требует: Усиленный двигатель"

msgid "GRAD-5 MLRS"
msgstr "РСЗО Град-5"

msgid "Unlocks production of the Grad-5 multiple launch rocket system."
msgstr "Позволяет производить реактивную систему залпового огня 'Град-5'."

msgid "GRAD-10 MLRS"
msgstr "РСЗО Град-10"

msgid ""
"Grad-5 upgrade: rocket range +15%, damage +30%.\n"
"Requires: Grad-5 MLRS."
msgstr ""
"Модернизация РСЗО 'Град-5'. Увеличивает дальность полета ракет на 15% и поражающую способность - на 30%.\n"
"Требует: РСЗО 'Град-5'."

msgid "REINFORCED GENERATOR"
msgstr "Усиленный генератор"

msgid "Power output +30%."
msgstr "Увеличивает количество вырабатываемой энергии на 30%."

msgid "TITANIUM PLATING"
msgstr "Титановая обшивка"

msgid "Armor of all structures +50%."
msgstr "Увеличивает броню всех сооружений на 50%."

msgid "ACTIVE WALL ARMOR"
msgstr "Активная броня стен"

msgid "Walls are twice as durable."
msgstr "Увеличивает прочность стен в 2 раза."

msgid "WARNING SYSTEM"
msgstr "Система предупреждения"

msgid "Unlocks the construction of radar locators."
msgstr "Позволяет строить локаторы."

msgid "EXPRESS INFANTRY SCHOOL"
msgstr "Экспресс-школа пехоты"

msgid "Infantry training time -30%."
msgstr "Снижает время подготовки пехоты на 30%."

msgid "ASSEMBLY LINE UPGRADE"
msgstr "Модернизация конвейера"

msgid "Vehicle production time -30%."
msgstr "Снижает время производства техники на 30%."

msgid "FINANCE DEPARTMENT"
msgstr "Финансовый отдел"

msgid "Income +20%."
msgstr "Увеличивает финансирование на 20%."

msgid "MOTIVATION SYSTEM"
msgstr "Система мотивации"

msgid "Reward for every destroyed enemy unit +50%."
msgstr "Вознаграждение за каждого уничтоженного юнита противника увеличивается на 50%."

msgid "COMMUNICATION SYSTEM"
msgstr "Система связи"

msgid "Base building radius +25%."
msgstr "Увеличивает радиус строительства базы на 25%."

msgid "TITANIUM VEST"
msgstr "Титановый бронежилет"

msgid "+1 armor for all infantry."
msgstr "Увеличивает броню всей пехоты на 1."

msgid "PERSONAL MEDKIT"
msgstr "Персональная аптечка"

msgid "Health regeneration of all infantry is 3 times faster."
msgstr "Для всей пехоты скорость регенерации здоровья увеличивается в 3 раза."

msgid "Rate of fire of riflemen +50%."
msgstr "Скорострельность пехотинцев увеличивается на 50%."

msgid "STIMULANTS"
msgstr "Допинг"

msgid "Speed of all infantry +1."
msgstr "Увеличивает скорость всей пехоты на 1."

msgid "LONG-RANGE ROCKETS"
msgstr "Ракеты дальнего радиуса"

