msgid "Shows the edited character on a canvas: idle, moving, attacking, dying."
msgstr "Показывает редактируемого персонажа на холсте: стоит, идёт, атакует, погибает."

msgid "Puts the edited character (A) next to another one (B) and compares their numbers."
msgstr "Ставит редактируемого персонажа (A) рядом с другим (B) и сравнивает их показатели."

msgid "Runs a battle of A against B with the game's combat rules."
msgstr "Запускает бой A против B по боевым правилам игры."

msgid "Edits the technology trees of both factions (assets/characters/research_*.yaml)."
msgstr "Правка деревьев технологий обеих фракций (assets/characters/research_*.yaml)."

msgid "Standing still animation."
msgstr "Анимация покоя."

msgid "Walking animation: the unit drives right, turns around and returns."
msgstr "Анимация движения: юнит едет вправо, разворачивается и возвращается."

msgid "Fires the weapons at the target point with the current weapon settings."
msgstr "Стрельба по точке цели с текущими настройками оружия."

msgid "Death animation of the unit or building."
msgstr "Анимация гибели юнита или здания."

msgid "Shows the remains left after death, stage by stage."
msgstr "Показывает остов, остающийся после гибели, стадию за стадией."

msgid "Plays the burning death variant of infantry."
msgstr "Показывает вариант гибели пехоты от огня."

msgid "Back to the mobile form (hotkey G)."
msgstr "Вернуть подвижную форму (клавиша G)."

msgid "Switches the unit to its stationary siege form (hotkey G)."
msgstr "Переводит юнит в неподвижную осадную форму (клавиша G)."

msgid "Restart the death animation again and again."
msgstr "Повторять анимацию гибели по кругу."

msgid "Resets the camera position and zoom."
msgstr "Сбрасывает положение и масштаб камеры."

msgid "Direction of the hull, 0-7 in 45 degree steps. Also set with the right mouse button on the canvas."
msgstr "Направление корпуса, 0-7 с шагом 45°. Также задаётся правой кнопкой мыши на холсте."

msgid "Direction of the turret, 0-7. Also set with the left mouse button on the canvas."
msgstr "Направление башни, 0-7. Также задаётся левой кнопкой мыши на холсте."

msgid "The turret follows the hull direction."
msgstr "Башня поворачивается вместе с корпусом."

msgid "Playback speed of the preview animations."
msgstr "Скорость воспроизведения анимаций."

msgid "Flight speed of bullets and shells in pixels per second (combat.bullet_speed)."
msgstr "Скорость полёта пуль и снарядов в пикселях в секунду (combat.bullet_speed)."

msgid "Speed multiplier of shot and hit animations (combat.fx_speed)."
msgstr "Множитель скорости анимации выстрела и попадания (combat.fx_speed)."

msgid "Magnification of the canvas. The mouse wheel over the canvas does the same."
msgstr "Масштаб холста. То же делает колесо мыши над холстом."

msgid "Puts the target point back in front of the unit."
msgstr "Возвращает точку цели перед юнитом."

msgid "Draws the attack range as a red circle (the minimum range is drawn inside it)."
msgstr "Рисует дальность атаки красным кругом (минимальная дальность — внутри него)."

msgid "Draws the sight radius as a green circle."
msgstr "Рисует радиус обзора зелёным кругом."

msgid "Draws a 5x5 tile grid under the character."
msgstr "Рисует сетку 5x5 клеток под персонажем."

msgid "Shows damage, DPS, range and burst figures over the canvas."
msgstr "Показывает урон, DPS, дальность и очередь поверх холста."

msgid "Health shown in the preview: damaged units and buildings look different."
msgstr "Здоровье в превью: повреждённые юниты и здания выглядят иначе."

msgid "Construction progress of the building shown in the preview."
msgstr "Степень достройки здания в превью."

msgid "Building with or without power (radars and turrets stop without it)."
msgstr "Здание с питанием или без (без питания радары и башни не работают)."

msgid "Shows the siege form of the unit with its own stats and weapon."
msgstr "Показывает осадную форму юнита с её характеристиками и оружием."

msgid "Filters the list by name, id, number or faction."
msgstr "Фильтр списка по имени, id, номеру или фракции."

msgid "Show units and buildings."
msgstr "Показать юнитов и здания."

msgid "Show units only."
msgstr "Только юниты."

msgid "Show buildings only."
msgstr "Только здания."

