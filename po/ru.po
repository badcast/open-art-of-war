msgid "HELP & CONTROLS"
msgstr "ПОМОЩЬ И УПРАВЛЕНИЕ"

msgid "- Mouse: LMB - select unit / box selection."
msgstr "- Управление мышью: ЛКМ - выбор юнита / рамка выделения."

msgid "- Orders: RMB on ground - move, RMB on enemy - attack."
msgstr "- Приказы: ПКМ на карту - перемещение, ПКМ на врага - атака."

msgid "- Camera: Arrow keys, WASD, or move mouse to screen edges."
msgstr "- Камера: Стрелки, WASD, или перемещение мыши к краям экрана."

msgid "- Construction (B): HQ, Power Plant, Barracks, Factory, Lab, Turrets."
msgstr "- Строительство (B): Штаб, Генератор, Казарма, Завод, Локатор, Турели."

msgid "- Production (1..7): Rifleman, Grenadier, Sniper, Coyote, Armadillo, Rhino, MLRS."
msgstr "- Производство (1..7): Пехотинец, Гренадер, Снайпер, Койот, Броненосец, Носорог, Дикобраз."

msgid "- Siege mode (G): Deploy Sniper and Rhino heavy tank."
msgstr "- Осадный режим (G): Развертывание Снайпера и тяжелого танка Носорог."

msgid "- Hotkeys: F12 - debug overlay, Space / ESC - pause."
msgstr "- Быстрые клавиши: F12 - панель отладки, Пробел / ESC - пауза."

