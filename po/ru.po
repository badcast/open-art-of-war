msgstr "Идентификация персонажа: id, имя и что это в игре."

msgid "Footprint, health, sight and speed."
msgstr "Размер, здоровье, обзор и скорость."

msgid "Price, build time and power of the character."
msgstr "Цена, время производства и мощность."

msgid "Settings shared by all weapons, and the weapons list."
msgstr "Общие настройки оружия и список оружия."

msgid "Which sprite sequences the game uses (derived from the archetype, read only)."
msgstr "Какие спрайтовые последовательности использует игра (следуют из архетипа, только чтение)."

msgid "Siege mode and upgraded / baseline forms."
msgstr "Осадный режим и улучшенные / базовые формы."

msgid "Unique text id of the configuration, e.g. rifleman_conf. The description in po/*.po is found by it."
msgstr "Уникальный текстовый id конфигурации, например rifleman_conf. По нему ищется описание в po/*.po."

msgid "Name shown in the game."
msgstr "Название, которое видно в игре."

msgid "Kind of building. The faction, structure type and sprites follow from it."
msgstr "Вид здания. Из него следуют фракция, тип постройки и спрайты."

msgid "Kind of unit. The faction, class, production building and sprites follow from it."
msgstr "Вид юнита. Из него следуют фракция, класс, здание-производитель и спрайты."

msgid "Width of the building on the map in tiles."
msgstr "Ширина здания на карте в клетках."

msgid "Height of the building on the map in tiles."
msgstr "Высота здания на карте в клетках."

msgid "Health points of the unit or building."
msgstr "Очки здоровья юнита или здания."

msgid "How far it sees, in tiles."
msgstr "Как далеко он видит, в клетках."

msgid "Speed of the unit in internal simulation units."
msgstr "Скорость юнита во внутренних единицах симуляции."

msgid "Price in credits."
msgstr "Цена в кредитах."

msgid "Positive: the building generates power. Negative: it consumes power."
msgstr "Положительное — здание вырабатывает энергию, отрицательное — потребляет."

msgid "Seconds to train the unit or build the building."
msgstr "Секунд на производство юнита или строительство здания."

msgid "Icon of the building in the construction menu (cameo composite)."
msgstr "Значок здания в меню строительства (композит-картинка)."

